# =========================================================
# CertWinX environment variables
# Copy to .env.local for local dev; set in Vercel for prod.
# NEVER commit real secrets. NEVER prefix a secret with NEXT_PUBLIC_.
# =========================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Gmail OAuth (optional if you only use Hostinger) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# ---- Hostinger SMTP (no env needed per sender; configured in the UI) ----
# Senders add their own email password in Senders -> Connect Hostinger Mail.
# Common hosts:
#   smtp.hostinger.com   (Hostinger Email)
#   smtp.titan.email     (Titan Email bundled with Hostinger plans)

# 32-byte base64 key for AES-256-GCM token encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Secret used by Vercel Cron / Python scheduler to authorize /api/cron/process
CRON_SECRET=

# Secret used to sign session cookies (any long random string)
AUTH_SECRET=

DEFAULT_TIMEZONE=Asia/Kolkata
MAX_EMAILS_PER_SENDER_24H=350
MAX_BATCH_SIZE=5
GLOBAL_SENDING_ENABLED=false
DEMO_MODE=true
